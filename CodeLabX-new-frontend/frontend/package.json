{
  "name": "codelabx-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write \"src/components/**/*.tsx\" \"src/pages/**/*.{ts,tsx}\" \"src/services/**/*.ts\" \"src/state/**/*.ts\" \"src/types/**/*.ts\" \"src/utils/**/*.ts\" \"src/hooks/**/*.ts\" \"src/styles/**/*.css\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
