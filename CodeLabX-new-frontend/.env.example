# Copy to frontend/.env.local and backend/src/main/resources or export as OS env vars.
# Never commit real secrets.

# --- Frontend ---
VITE_API_URL=http://localhost:8080
# Optional local UI preview only; leave unset to show real API errors.
VITE_ENABLE_MOCK_DATA=false

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL (default runtime database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codelabx
POSTGRES_USER=codelabx
POSTGRES_PASSWORD=codelabx-local

# JWT
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# External sandboxed code execution (Phase 1)
# Providers: piston (default), judge0, mock
CODE_EXECUTION_PROVIDER=piston
CODE_EXECUTION_TIMEOUT_MS=12000

# Piston. The public API now requires authorization; for local use, point this
# at a self-hosted Piston endpoint and leave authorization blank.
# Local Piston service started by `docker compose up -d piston`.
PISTON_API_URL=http://127.0.0.1:2000/api/v2/execute
PISTON_AUTHORIZATION=
PISTON_JAVA_VERSION=17.x
PISTON_PYTHON_VERSION=3.x

# Judge0 (RapidAPI or self-hosted). Leave blank if unused.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
