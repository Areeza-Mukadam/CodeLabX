# ==============================================================================
# CodeLabX - Safe Development Environment Configuration (.env.example)
# Copy this file to .env before starting services with Docker Compose
# ==============================================================================

# --- Frontend Service Configuration ---
# Public URL accessible from browser to communicate with backend
VITE_API_URL=http://localhost:8080
# Set to false to interact with real PostgreSQL and Spring Boot services
VITE_ENABLE_MOCK_DATA=false
# Published port for frontend web application
FRONTEND_PORT=5173

# --- Backend Service Configuration ---
SERVER_PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# --- PostgreSQL Database (Internal Compose Service) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=codelabx
POSTGRES_USER=codelabx
POSTGRES_PASSWORD=codelabx-local

# --- JWT Authentication (Safe Development Defaults) ---
JWT_SECRET=codelabx-dev-only-change-this-secret-key-at-least-32-chars-long!
JWT_EXPIRATION_MS=86400000

# --- Sandboxed Code Execution Service (Piston) ---
CODE_EXECUTION_PROVIDER=piston
CODE_EXECUTION_TIMEOUT_MS=12000
PISTON_PORT=2000
PISTON_API_URL=http://piston:2000/api/v2/execute
PISTON_AUTHORIZATION=
PISTON_JAVA_VERSION=17.x
PISTON_PYTHON_VERSION=3.x

# --- Optional Judge0 Provider (Unused in local compose) ---
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
