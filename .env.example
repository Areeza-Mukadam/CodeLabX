# Copy to frontend/.env.local and backend/src/main/resources or export as OS env vars.
# Never commit real secrets.

# --- Frontend ---
VITE_API_URL=http://localhost:8080

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=h2

# PostgreSQL (used when SPRING_PROFILES_ACTIVE=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codelabx
POSTGRES_USER=codelabx
POSTGRES_PASSWORD=change-me

# JWT
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# External sandboxed code execution (Phase 1)
# Providers: piston (default), judge0, mock
CODE_EXECUTION_PROVIDER=piston
CODE_EXECUTION_TIMEOUT_MS=12000

# Piston (default public endpoint — replace if you self-host)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
PISTON_JAVA_VERSION=15.0.2
PISTON_PYTHON_VERSION=3.10.0

# Judge0 (RapidAPI or self-hosted). Leave blank if unused.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
